# API port; Vite forwards /api and /uploads to this port during development.
PORT=4000
# SMTP settings shared by homepage, contact and booking enquiries.
# Port 587 uses STARTTLS (false); port 465 uses implicit TLS (true).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
# Use an address your SMTP account is authorized to send from.
SMTP_FROM=bookings@example.com
# Booking team inbox. Sender receipts reply here unless SMTP_REPLY_TO is set.
SMTP_TO=your-inbox@example.com
# Optional customer-facing reply address:
# SMTP_REPLY_TO=bookings@example.com
